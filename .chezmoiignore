# Repository files (not dotfiles)
README.md
CLAUDE.md
LICENSE
justfile
install.sh
devbox.json
devbox.lock

# Editor/tooling configs for this repo
.editorconfig
.stylua.toml
.gitignore
.gitkeep

# CI/IDE directories
.github/

# macOS specific
{{ if ne .chezmoi.os "darwin" }}
.config/karabiner/
Library/
homebrew/
{{ end }}

# Linux specific (servers don't need GUI terminal config)
{{ if ne .chezmoi.os "linux" }}
.config/i3/
.config/sway/
{{ end }}

# SSH/Server environment - skip GUI apps
{{ if and (eq .chezmoi.os "linux") (env "SSH_CLIENT") }}
.config/ghostty/
{{ end }}

# Work-specific files on personal machines
{{ if not .business_use }}
.config/git/freee
.config/colima/
homebrew/Brewfile.work
.claude/rules/pr-size.md
.claude/skills/acli/
{{ end }}

# Personal-only AtCoder tooling (excluded on work machines)
{{ if .business_use }}
.config/atcoder-cli-nodejs/
.config/zsh/split/atcoder.zsh
.chezmoiscripts/run_once_after_configure-atcoder-cli.sh
.chezmoiscripts/run_once_after_create-atcoder-workspace.sh
.chezmoiscripts/run_onchange_after_install-atcoder-tools.sh
{{- if eq .chezmoi.os "darwin" }}
Library/Preferences/atcoder-cli-nodejs
{{- end }}
{{ end }}

# devbox lock (environment-dependent, generated by devbox install)
.local/share/devbox/global/default/devbox.lock

# Local files (never managed by chezmoi)
.zshrc.local
.config/zsh/local.zsh
.env.local

