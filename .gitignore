# Override global gitignore to track devbox files in this repo
!devbox.json

# devbox.lock is environment-dependent (business_use flag changes packages)
dot_local/share/devbox/global/default/devbox.lock

# Local directories
.claude/
.firecrawl/

# Python tooling caches (pytest harness under tests/skills/)
__pycache__/
.pytest_cache/

# workmux Copilot CLI hooks (unused; auto-created by `workmux setup` if it detects Copilot CLI)
.github/hooks/

# Colima: track operator-edited templates, ignore runtime artefacts
# (default/, certs/, _lima/ are regenerated by colima itself on delete/start)
dot_config/colima/default/
dot_config/colima/certs/
dot_config/colima/_lima/
