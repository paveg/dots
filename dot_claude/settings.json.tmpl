{
  "permissions": {
    "allow": [
      "Bash(mysql:*)",
      "Bash(gh*)",
      "Bash(go*)",
      "Bash(git worktree*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf .:*)",
      "Bash(rm -rf ..:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(killall:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(mongod:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.envrc)",
      "Read(**/.envrc.*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*_key)",
      "Read(**/*_key.*)",
      "Read(**/*credential*)",
      "Read(**/*password*)",
      "Read(**/*secret*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Write(**/.env*)",
      "Write(**/secrets/**)",
      "Write(**/.ssh/*)",
      "Write(**/authorized_keys)",
      "mcp__supabase__execute_sql"
    ]
  },
{{- if .business_use }}
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.inhouse-flugel.freee.co.jp/proxy/anthropic_pass_through"
  },
{{- end }}
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "explanatory-output-style@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true{{- if .business_use }},
    "code-flow@freee-ccplugins-marketplace": true
{{- else }},
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
{{- end }}
  },
{{- if not .business_use }}
  "extraKnownMarketplaces": {
    "rust-skills": {
      "source": {
        "source": "github",
        "repo": "ZhangHanDong/rust-skills"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
{{- end }}
  "alwaysThinkingEnabled": true,
  "language": "Follow the user's input language. Prioritize accuracy. Think step-by-step. Do not guess—ask or investigate when uncertain.",
  "claudeMdExcludes": [
    "**/.claude/rules/gh-pr-body.md",
    "**/.claude/rules/chezmoi.md",
    "**/.claude/rules/react.md",
    "**/.claude/rules/browser-automation.md",
    "**/.claude/rules/drizzle.md",
    "**/.claude/rules/zero-cost-scaling.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gh-pr-inject.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rules-inject.sh"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/browser-inject.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mermaid-render.sh"
          }
        ]
      }
    ]
  }
}
