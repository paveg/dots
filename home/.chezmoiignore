# Python bytecode (generated by running skill scripts/tests; never deploy)
**/__pycache__/
**/*.pyc

# macOS specific
# Scripts are matched by target name, which has the run_* prefix stripped —
# naming the source file here would never match. Verify with `chezmoi ignored`.
{{ if ne .chezmoi.os "darwin" }}
.config/karabiner/
Library/
homebrew/
.chezmoiscripts/configure-macos-keyboard.sh
{{ end }}

# Linux specific (servers don't need GUI terminal config)
{{ if ne .chezmoi.os "linux" }}
.config/i3/
.config/sway/
{{ end }}

# SSH/Server environment - skip GUI apps
{{ if and (eq .chezmoi.os "linux") (env "SSH_CLIENT") }}
.config/ghostty/
{{ end }}

# Work-specific files on personal machines
{{ if not .business_use }}
.config/aquaproj-aqua/
.config/fdev-mcp/
.chezmoiscripts/generate-fdev-ca-bundle.sh
.config/git/freee
.config/colima/
homebrew/Brewfile.work
.claude/skills/acli/
{{ end }}

# Personal-only skills (excluded on work machines)
{{ if .business_use }}
.claude/skills/equity-decision/
.claude/skills/ipo-decision/
.claude/skills/trend-arbitrage/
.claude/skills/x-post-craft/
.claude/skills/zero-cost-scaling/
.claude/skills/ios-submission-review/
{{ end }}

# Personal-only AtCoder tooling (excluded on work machines)
{{ if .business_use }}
.config/atcoder-cli-nodejs/
.config/zsh/atcoder.zsh
.chezmoiscripts/configure-atcoder-cli.sh
.chezmoiscripts/create-atcoder-workspace.sh
.chezmoiscripts/install-atcoder-tools.sh
{{- if eq .chezmoi.os "darwin" }}
Library/Preferences/atcoder-cli-nodejs
{{- end }}
{{ end }}

# devbox lock (environment-dependent, generated by devbox install)
.local/share/devbox/global/default/devbox.lock

# Local files (never managed by chezmoi)
.zshrc.local
.config/zsh/local.zsh
.env.local

