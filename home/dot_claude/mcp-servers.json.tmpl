{
  "mcpServers": {
{{- if not .business_use }}
    "textlint": {
      "command": "textlint",
      "args": ["--mcp"]
    },
    "1password": {
      "command": "1password-mcp"
    }
{{- else }}
    "fdev-helmfile": {
      "command": "fdev-mcp-server",
      "args": ["server", "helmfile"],
      "env": {
        "AQUA_GLOBAL_CONFIG": "{{ .chezmoi.homeDir }}/.config/aquaproj-aqua/aqua.yaml",
        "HELM_BIN": "{{ .chezmoi.homeDir }}/.local/share/aquaproj-aqua/bin/helm",
        "HELMFILE_COMMAND": "{{ .chezmoi.homeDir }}/.local/share/aquaproj-aqua/bin/helmfile"
      }
    },
    "fdev-terraform": {
      "command": "fdev-mcp-server",
      "args": ["server", "terraform"],
      "env": {
        "AQUA_GLOBAL_CONFIG": "{{ .chezmoi.homeDir }}/.config/aquaproj-aqua/aqua.yaml",
        "TERRAFORM_COMMAND": "{{ .chezmoi.homeDir }}/.local/share/aquaproj-aqua/bin/terraform"
      }
    },
    "fdev-argocd-production": {
      "command": "fdev-mcp-server",
      "args": ["server", "argocd", "--env", "production"]
    },
    "fdev-argocd-staging": {
      "command": "fdev-mcp-server",
      "args": ["server", "argocd", "--env", "staging"]
    },
    "fdev-aws": {
      "command": "fdev-mcp-server",
      "args": ["server", "aws", "--multi-account"],
      "env": {
        "AWS_CA_BUNDLE": "{{ .chezmoi.homeDir }}/.config/fdev-mcp/ca-bundle.crt",
        "AWS_DEFAULT_REGION": "ap-northeast-1",
        "REQUESTS_CA_BUNDLE": "{{ .chezmoi.homeDir }}/.config/fdev-mcp/ca-bundle.crt",
        "SSL_CERT_FILE": "{{ .chezmoi.homeDir }}/.config/fdev-mcp/ca-bundle.crt",
        "UV_CONSTRAINT": "{{ .chezmoi.homeDir }}/.config/fdev-mcp/uv-constraints.txt"
      }
    },
    "fdev-aws-doc": {
      "command": "fdev-mcp-server",
      "args": ["server", "aws-doc"]
    },
    "fdev-datadog": {
      "command": "fdev-mcp-server",
      "args": ["server", "datadog"]
    },
    "fdev-kubernetes": {
      "command": "fdev-mcp-server",
      "args": ["server", "kubernetes"]
    },
    "fdev-slack": {
      "command": "fdev-mcp-server",
      "args": ["server", "slack"]
    }
{{- end }}
  }
}
