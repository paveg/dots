{
{{- if .business_use }}
  "enableArtifact": false,
{{- end }}
  "advisorModel": "fable",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(chezmoi init:*) without XDG_CONFIG_HOME pointing at a temp dir — rewrites the real ~/.config/chezmoi/chezmoi.yaml even with --dry-run, and can poison shell env via BUSINESS_USE"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mysql:*)",
      "Bash(gh*)",
      "Bash(go*)",
      "Bash(git worktree*)"
    ],
    "ask": [
      "Bash(git clean:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws rds delete-db-instance:*)",
      "Bash(aws rds delete-db-cluster:*)",
      "Bash(aws cloudformation delete-stack:*)",
      "Bash(aws eks delete-cluster:*)",
      "Bash(aws kms schedule-key-deletion:*)",
      "Bash(aws secretsmanager delete-secret:*)",
      "Bash(aws dynamodb delete-table:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform import:*)",
      "Bash(terraform taint:*)",
      "Bash(sops -d:*)",
      "Bash(sops --decrypt:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl drain:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(helm upgrade:*)"
    ],
{{- /* Destructive-command guards below overlap with home/dot_codex/rules/custom.rules.tmpl — when adding a pattern, update both. */}}
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf .:*)",
      "Bash(rm -rf ..:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(killall:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(aws s3 rb --force:*)",
      "Bash(terraform apply -auto-approve:*)",
      "Bash(terraform destroy -auto-approve:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(mongod:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.envrc)",
      "Read(**/.envrc.*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*_key)",
      "Read(**/*_key.*)",
      "Read(**/*credential*)",
      "Read(**/*password*)",
      "Read(**/*secret*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Edit(**/.env*)",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/*)",
      "Edit(**/authorized_keys)",
      "mcp__supabase__execute_sql"
    ],
    "defaultMode": "auto"
  },
  "env": {
{{- if .business_use }}
    "ANTHROPIC_BASE_URL": "https://api.inhouse-flugel.freee.co.jp/proxy/anthropic_pass_through",
{{- end }}
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "explanatory-output-style@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": false,
    "example-skills@anthropic-agent-skills": false{{- if .business_use }},
    "code-flow@freee-ccplugins-marketplace": true
{{- else }},
    "frontend-design@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
{{- end }}
  },
  "skillOverrides": {
    "agents-sdk": "off",
    "browser-e2e-test": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "durable-objects": "off",
    "firecrawl-agent": "off",
    "firecrawl-browser": "off",
    "firecrawl-crawl": "off",
    "firecrawl-download": "off",
    "firecrawl-map": "off",
    "interrupt": "off",
    "ipo-decision": "off",
    "issue-ship": "off",
    "learning-primer": "off",
    "sandbox-sdk": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "x-post-craft": "off"
  },
{{- if not .business_use }}
  "extraKnownMarketplaces": {
    "rust-skills": {
      "source": {
        "source": "github",
        "repo": "ZhangHanDong/rust-skills"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
{{- end }}
  "alwaysThinkingEnabled": true,
  "switchModelsOnFlag": false,
  "worktree": {
    "baseRef": "head"
  },
  "claudeMdExcludes": [
    "**/.claude/rules/gh-pr-body.md",
    "**/.claude/rules/browser-automation.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-destructive-db.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-credential-read.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gh-pr-inject.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-unsigned-commits.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block-rot-comments.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/japanese-writing-inject.sh"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/browser-inject.sh"
          }
        ]
      },
      {
        "_tag": "ccstatusline-managed",
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bunx -y ccstatusline@latest --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "_tag": "ccstatusline-managed",
        "hooks": [
          {
            "type": "command",
            "command": "bunx -y ccstatusline@latest --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "statusMessage": "Checking for unaddressed requests",
            "prompt": "You check one thing: is Claude ending its turn with something the user asked for left neither done nor reported? Hook input: $ARGUMENTS\n\n1. If stop_hook_active is true, return {\"ok\": true} at once: one reminder per stop is the limit.\n   Also return {\"ok\": true} at once, without searching, when this was a short exchange: last_assistant_message is a brief answer that mentions no commit, file, branch, PR, or test run, and background_tasks is empty.\n2. List the user's own messages with two Grep searches on transcript_path: the literal text \"role\":\"user\",\"content\":\" (typed turns), and The user sent a new message while you were working (messages sent mid-turn; the request follows that line). Not from the user, so skip: <agent-message>, <task-notification>, <local-command-stdout>, Stop hook feedback, and hook-status lines. A slash command's <command-args> is the user's request. Requests from the most recent user message back to Claude's previous final report are in scope; older ones only if never addressed since. A question asks for an answer, not an action.\n3. The transcript may lag, so judge Claude's final reply from last_assistant_message. Classify each request: done (acted on or answered), explicitly deferred, blocked, or declined with a reason, waiting on a decision Claude asked the user for, or missing.\n4. Any missing: return {\"ok\": false, \"reason\": \"Unaddressed: <short list>. Do each, or say why it can't be done, then finish.\"}. Otherwise {\"ok\": true}.\n\nJudge coverage only, never quality or approach. When unsure, return {\"ok\": true}."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
