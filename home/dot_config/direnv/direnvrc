# shellcheck shell=bash
# =============================================================================
# direnv standard library extensions
# =============================================================================

# dotenv_if_exists is provided by direnv's standard library. Keep that
# implementation: it registers .env with watch_file so active shells reload
# data changes without requiring the approved .envrc to change.

# dotenv_if_exists_up: Search for .env up the directory tree
# The standard-library dotenv call registers the discovered file with
# watch_file.
dotenv_if_exists_up() {
  local env_file="${1:-.env}"
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/$env_file" ]]; then
      dotenv "$dir/$env_file"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
}
