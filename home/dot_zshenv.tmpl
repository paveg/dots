# =============================================================================
# Zsh Environment (sourced for all shells)
# =============================================================================

# XDG Base Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Zsh config location (disabled - using ~/.zshrc directly for simplicity)
# export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Locale
# en_US.UTF-8 is always present on macOS but is not generated on a stock
# Ubuntu/WSL2, where only C.UTF-8 exists — forcing it there makes every
# child process warn and fall back to the C locale. glibc spells it
# "en_US.utf8", macOS "en_US.UTF-8". LC_ALL is left unset so per-category
# system settings still apply.
if locale -a 2>/dev/null | grep -qiEx 'en_US\.utf-?8'; then
  export LANG=en_US.UTF-8
else
  export LANG=C.UTF-8
fi

# Editor
export EDITOR=nvim
export VISUAL=nvim

# Pager
export PAGER=less
export MANPAGER="less -R"

{{- if eq .chezmoi.os "darwin" }}
# =============================================================================
# macOS specific
# =============================================================================
export HOMEBREW_PREFIX="{{ .homebrew_prefix }}"
export HOMEBREW_CELLAR="{{ .homebrew_prefix }}/Cellar"
export HOMEBREW_REPOSITORY="{{ .homebrew_prefix }}"
export PATH="{{ .homebrew_prefix }}/bin:{{ .homebrew_prefix }}/sbin:$PATH"
export MANPATH="{{ .homebrew_prefix }}/share/man:$MANPATH"
export INFOPATH="{{ .homebrew_prefix }}/share/info:$INFOPATH"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1
{{- end }}

# =============================================================================
# Path
# =============================================================================
typeset -U path PATH

{{ include "dot_config/zsh/init/generated-cache.zsh" }}

# Devbox global (rebuilds PATH from its own stack — must come before user tools)
_devbox_legacy_cache="${XDG_CACHE_HOME}/devbox/shellenv.zsh"
_devbox_cache="${XDG_CACHE_HOME}/devbox/shellenv-pure.zsh"

# Never trust the pre-pure cache: it may contain inherited secrets or
# session-specific values from the shell that generated it.
if [[ -f "$_devbox_legacy_cache" || -L "$_devbox_legacy_cache" ]]; then
  command rm -f -- "$_devbox_legacy_cache"
fi

_zsh_generate_devbox_shellenv() {
  emulate -L zsh
  setopt local_options pipe_fail

  # --pure excludes inherited variables. The filter is defense in depth for
  # shell identity, session, multiplexer, temporary, and secret-like exports.
  command devbox global shellenv --pure |
    command grep -Ev '^export (HOME|USER|LOGNAME|DISPLAY|WAYLAND_DISPLAY|PWD|OLDPWD|SHLVL|_|DEVBOX_PURE_SHELL|TMUX[A-Z0-9_]*|TERM[A-Z0-9_]*|COLORTERM|ITERM_[A-Z0-9_]*|LC_TERMINAL(_VERSION)?|SSH_[A-Z0-9_]*|TMPDIR|WINDOWID|XDG_(RUNTIME_DIR|SESSION_[A-Z0-9_]*)|DBUS_SESSION_BUS_ADDRESS|SECURITYSESSIONID|HERDR_[A-Z0-9_]*|[A-Z0-9_]*(SECRET|TOKEN|PASSWORD|CREDENTIAL)[A-Z0-9_]*)='
}

_zsh_merge_devbox_search_path() {
  emulate -L zsh
  local variable_name="$1"
  local generated_value="$2"
  local baseline_value="$3"
  local -aU components

  components=(
    "${(@s/:/)generated_value}"
    "${(@s/:/)baseline_value}"
  )
  typeset -g "$variable_name=${(j/:/)components}"
}

if command -v devbox &>/dev/null; then
  # Pure mode deliberately emits fully resolved search paths. Preserve the
  # current shell's paths in memory and append them after the Devbox paths so
  # package binaries keep precedence without dropping system or Homebrew data.
  _devbox_base_path="$PATH"
  _devbox_base_manpath="${MANPATH:-}"
  _devbox_base_infopath="${INFOPATH:-}"
  _devbox_base_xdg_data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  _devbox_binary="${commands[devbox]:A}"
  _devbox_manifest="${XDG_DATA_HOME}/devbox/global/default/devbox.json"
  _devbox_lock="${XDG_DATA_HOME}/devbox/global/default/devbox.lock"
  _devbox_refresh=0
  if [[ "$_devbox_binary" -nt "$_devbox_cache" ]] ||
    [[ -e "$_devbox_manifest" && "$_devbox_manifest" -nt "$_devbox_cache" ]] ||
    [[ -e "$_devbox_lock" && "$_devbox_lock" -nt "$_devbox_cache" ]]; then
    _devbox_refresh=1
  fi
  _devbox_fingerprint="dots-generated-zsh-cache-v1|devbox-shellenv-pure-v1|${_devbox_binary}"

  if _zsh_cache_prepare \
    "$_devbox_cache" \
    "$_devbox_refresh" \
    "$_devbox_fingerprint" \
    _zsh_generate_devbox_shellenv; then
    source "$_devbox_cache"
    export PATH="${PATH:+$PATH:}${_devbox_base_path}"
    _zsh_merge_devbox_search_path MANPATH "${MANPATH:-}" "$_devbox_base_manpath"
    _zsh_merge_devbox_search_path INFOPATH "${INFOPATH:-}" "$_devbox_base_infopath"
    _zsh_merge_devbox_search_path \
      XDG_DATA_DIRS \
      "${XDG_DATA_DIRS:-}" \
      "$_devbox_base_xdg_data_dirs"
    export MANPATH INFOPATH XDG_DATA_DIRS
  fi
fi
# DEVBOX_PURE_SHELL describes the generator subprocess, not the current shell.
unset DEVBOX_PURE_SHELL
unfunction \
  _zsh_generate_devbox_shellenv \
  _zsh_merge_devbox_search_path \
  2>/dev/null
unset \
  _devbox_base_infopath \
  _devbox_base_manpath \
  _devbox_base_path \
  _devbox_base_xdg_data_dirs \
  _devbox_binary \
  _devbox_cache \
  _devbox_fingerprint \
  _devbox_legacy_cache \
  _devbox_lock \
  _devbox_manifest \
  _devbox_refresh

# User tool paths (after devbox to avoid being overwritten)
export BUN_INSTALL="$HOME/.bun"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$BUN_INSTALL/bin:$HOME/.moon/bin:${PATH}:${HOME}/go/bin"

# ghq root
export GHQ_ROOT="$HOME/repos"

# gitleaks global config
export GITLEAKS_CONFIG="$XDG_CONFIG_HOME/gitleaks/config.toml"

# aqua must outrank Homebrew and devbox: a repository's .aqua.yaml pins the
# versions its CI runs, and the same binary has to resolve here. This prepend
# covers non-interactive shells; .zshrc re-asserts it on every prompt, because
# brew shellenv and mise's hook both rebuild PATH after this file is read.
export AQUA_GLOBAL_CONFIG="$XDG_CONFIG_HOME/aquaproj-aqua/aqua.yaml"
export PATH="$XDG_DATA_HOME/aquaproj-aqua/bin:$PATH"

{{- if .business_use }}
# =============================================================================
# Business Environment
# =============================================================================
export BUSINESS_USE=1
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

# aqua reads its GitHub token from macOS Keychain — some C-FO repos resolve a
# private aqua-registry, which needs an SSO-authorized token. Store it with
# `aqua-token-sync` (features/aqua-token-sync.zsh); rerun after gh re-login
# rotates the token. A GITHUB_TOKEN env var takes precedence and disables this.
export AQUA_KEYRING_ENABLED=true

# Corporate TLS inspection CA: wire palo-root.pem (in Homebrew's cert store)
# into common SSL env vars so curl/Node/Python/Ruby-OpenSSL trust certificates
# reissued by a corporate TLS-inspecting proxy.
# PATH ordering for openssl@3 and general Homebrew bin is handled in .zshrc
# (must run last to survive subsequent reordering by mise/devbox/pnpm/etc.).
# NIX_SSL_CERT_FILE is read by nix-built tools (devbox, nix CLI, builders that
# inherit env), which ignore the standard SSL_CERT_FILE and use their own
# baked-in CA bundle path otherwise.
_brew_ca_dir="{{ .homebrew_prefix }}/etc/openssl@3/certs"
_brew_palo_ca="$_brew_ca_dir/palo-root.pem"

if [[ -f "$_brew_palo_ca" ]]; then
  export CAPATH="$_brew_ca_dir"
  export NODE_EXTRA_CA_CERTS="$_brew_palo_ca"
  export CURL_CA_BUNDLE="$_brew_palo_ca"
  export NIX_SSL_CERT_FILE="$_brew_palo_ca"
fi

unset _brew_ca_dir _brew_palo_ca

# nix-provided npm defaults its global prefix to the read-only /nix/store,
# so `npm install -g` fails with EACCES. Redirect globals to a writable XDG
# dir. An env var outranks ~/.npmrc, so this also survives `chezmoi apply`
# wiping any manually-added prefix line there.
export NPM_CONFIG_PREFIX="$XDG_DATA_HOME/npm-global"
export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"
{{- end }}
