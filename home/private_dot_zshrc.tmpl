# =============================================================================
# aqua PATH precedence
# =============================================================================
# .zshenv puts aqua at the front, but brew shellenv and mise's precmd hook both
# rebuild PATH afterwards and push it behind Homebrew and devbox. Re-assert it
# every prompt. Registered before _brew_force_openssl_path so that hook still
# lands at position 1 and aqua takes position 2, ahead of both.
_aqua_force_path() {
  local aqua_bin="${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua/bin"
  [[ -d "$aqua_bin" ]] || return
  [[ "${PATH%%:*}" == "$aqua_bin" ]] && return
  export PATH="$aqua_bin:${PATH//:$aqua_bin/}"
}
typeset -ag precmd_functions
precmd_functions+=(_aqua_force_path)

{{- if .business_use }}

# =============================================================================
# Work Environment
# =============================================================================
# mise activates earlier in zshrc and snapshots PATH; on every prompt its
# precmd hook restores PATH from that snapshot, appending anything added
# later (incl. keg-only openssl@3) to the back. Force openssl@3 to stay
# at the front via our own precmd hook, registered AFTER mise's so it
# runs later in the chain.
_brew_force_openssl_path() {
  local brew_openssl="{{ .homebrew_prefix }}/opt/openssl@3/bin"
  [[ -d "$brew_openssl" ]] || return
  [[ "${PATH%%:*}" == "$brew_openssl" ]] && return
  export PATH="$brew_openssl:${PATH//:$brew_openssl/}"
}
typeset -ag precmd_functions
precmd_functions+=(_brew_force_openssl_path)
{{- end }}
