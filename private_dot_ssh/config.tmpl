# SSH Config - Common settings
# Host-specific settings should be in ~/.ssh/config.local

# Include local/private configurations first.
# First-obtained-value wins in OpenSSH: an IdentityAgent set per-host here
# permanently overrides the SSH_TTY-gated 1Password block at the bottom.
Include ~/.ssh/config.local
{{- if .business_use }}
# Colima VM SSH config (generated by colima, not managed by chezmoi)
Include ~/.config/colima/ssh_config
{{- end }}

# Global defaults
Host *
  IdentitiesOnly yes
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}
  ForwardAgent yes
  ForwardX11 no
  Protocol 2
  Tunnel no
  VisualHostKey no
  ServerAliveInterval 15
  ServerAliveCountMax 5
  # Use xterm-256color for compatibility (most servers lack Ghostty terminfo)
  SetEnv TERM=xterm-256color
{{- if eq .chezmoi.os "darwin" }}

# 1Password agent only in local sessions; in SSH sessions the forwarded agent
# (SSH_AUTH_SOCK) must win so requests are authorized on the client device.
# https://www.1password.dev/ssh/agent/forwarding#remote-workstation
Match host * exec "test -z $SSH_TTY"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
