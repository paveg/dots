# SSH Config - Common settings
# Host-specific settings should be in ~/.ssh/config.local

# Include local/private configurations first
Include ~/.ssh/config.local
{{- if .business_use }}
# Colima VM SSH config (generated by colima, not managed by chezmoi)
Include ~/.config/colima/ssh_config
{{- end }}

# Global defaults
Host *
  IdentitiesOnly yes
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
  ForwardAgent yes
  ForwardX11 no
  Protocol 2
  Tunnel no
  VisualHostKey no
  ServerAliveInterval 15
  ServerAliveCountMax 5
  # Use xterm-256color for compatibility (most servers lack Ghostty terminfo)
  SetEnv TERM=xterm-256color
